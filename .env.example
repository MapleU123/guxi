# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ===== 微信公众号登录（website-to-wechat）=====
# 公众号后台「消息与事件推送」-> 安全模式
# 原始 ID 默认 gh_7d39de02f610（与前端 wechatPairingService 一致），如不同请在后台核对
WECHAT_MP_APP_ID=wxYourAppId
WECHAT_MP_ORIGINAL_ID=gh_7d39de02f610
# Token：与后台「消息与事件推送」一致。可用此前对话中生成的 32 位 hex，
#   或自行生成：node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
WECHAT_MP_TOKEN=replace_with_32hex_token
# EncodingAESKey：必须在公众号后台「随机生成」（43 位），原样复制过来；不要自己写
WECHAT_MP_AES_KEY=replace_with_43char_aeskey
# CODE_SECRET：此前对话中生成的 >=32 字节 base64url，
#   或自行生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WECHAT_MP_CODE_SECRET=replace_with_code_secret

# 灰度开关：先 WEBHOOK=true + LOGIN=false（只开回调验收），通过后把 LOGIN 置 true
WECHAT_MP_WEBHOOK_ENABLED=true
WECHAT_MP_LOGIN_ENABLED=false

# 微信内回复「下载」返回的资料链接（不登录也行）
DOWNLOAD_REPLY=https://a-studio-1816.ai.studio/download
